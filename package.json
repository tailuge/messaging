{
  "name": "@tailuge/messaging",
  "version": "1.18.0",
  "type": "module",
  "description": "A stateful messaging library for Nchan-powered real-time applications.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "MESSAGING_SPEC.md",
    "SKILL.md"
  ],
  "scripts": {
    "test": "jest --config test/jest.config.cjs --verbose",
    "coverage": "jest --config test/jest.config.cjs --coverage",
    "playwright": "npm run docker:build && npx playwright test playwright/lobby-flow.spec.ts",
    "test:debug": "npm run playwright",
    "lint": "tsc --noEmit && npx oxlint src test",
    "prettify": "npx oxfmt src test",
    "build": "tsc --declaration && node scripts/add-js-extensions.js",
    "release": "npm version minor --no-git-tag-version && npm run build",
    "build:all": "npm run build && npm run docker:start",
    "docker:start": "bash scripts/docker-nchan.sh",
    "docker:stop": "bash scripts/docker-nchan.sh stop",
    "docker:build": "npm run build:all",
    "docker:push": "docker push tailuge/billiards-network:3.0.0 && bash scripts/trigger_render.sh",
    "deps": "npx npm-check",
    "docker:logs": "bash scripts/docker-nchan.sh logs"
  },
  "keywords": [
    "messaging",
    "nchan",
    "real-time",
    "presence",
    "lobby"
  ],
  "author": "tailuge",
  "license": "GPL-3.0",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/jest": "30.0.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.0",
    "http-server": "^14.1.1",
    "jest": "30.3.0",
    "oxlint": "^1.63.0",
    "testcontainers": "^11.14.0",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.3",
    "ws": "^8.20.0"
  },
  "browserslist": [
    "defaults",
    "ios >= 12",
    "safari >= 12"
  ]
}
